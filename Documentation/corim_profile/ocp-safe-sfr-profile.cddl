; Auditor CoRIM – Corim which embeds the SFR fields
; OCP SAFE SFR CoRIM Profile OID: 1.3.6.1.4.1.42623.1.1

$$measurement-values-map-extension //= (
  &(ocp-safe-sfr: -1) => ocp-safe-sfr-map ; Private extension for OCP SAFE SFR
)

ocp-safe-sfr-map = {
  &(review-framework-version: 0) => tstr
  &(report-version: 1) => tstr
  &(completion-date: 2) => time
  &(scope-number: 3) => integer
  ? &(fw-identifiers: 4) => [ + fw-identifier ]
  ? &(issues: 5) => [ + issue-entry ]
  ? &(solid-version: 6) => tstr
  * $$ocp-safe-sfr-map-ext
}

issue-entry = {
  &(title: 0) => tstr
  &(description: 1) => tstr
  &(assessment: 2) => $assessment
  ?&(cwe: 3) => tstr
  ?&(cve: 4) => tstr
  * $$ocp-safe-issue-entry-ext
}

; The three $assessment alternatives are distinguished by an explicit
; assessment-type discriminator at key 4, so alternatives are never told apart
; by which optional or required fields happen to be present:
;   - jil and qualitative-rating MUST carry assessment-type (new alternatives,
;     no legacy data).
;   - cvss MAY omit it so already-published SFRs that predate the field still
;     validate; absence means legacy cvss.
; Future assessment types MUST claim the next unused assessment-type value and
; use key 4 for it.
assessment-type = &(
  cvss: 0,
  jil: 1,
  qualitative-rating: 2
)

$assessment /= cvss
$assessment /= jil
$assessment /= qualitative-rating

cvss = {
  &(cvss-score: 0) => tstr
  &(cvss-vector: 1) => tstr
  ? &(cvss-version: 2) => tstr
  ? &(assessment-type: 4) => 0 ; cvss; absent in legacy data
}

; JIL attack potential scoring (per the Joint Interpretation Library "Application
; of Attack Potential to Smartcards and Similar Devices" methodology used in
; Common Criteria hardware evaluations). Used for Scope 3 physical-attack
; findings confirmed via physical testing on silicon; see review_scope.md's
; Finding rating guidance for when JIL applies versus qualitative-rating.
jil = {
  &(jil-rating: 0) => tstr ; e.g. "Basic", "Enhanced-Basic", "Moderate", "High", "Beyond High"
  ? &(jil-identification: 1) => jil-factor-scores
  ? &(jil-exploitation: 2) => jil-factor-scores
  ? &(jil-version: 3) => tstr ; JIL attack potential methodology version, e.g. "3.2.1"
  &(assessment-type: 4) => 1 ; jil
}

; Each of the five JIL attack potential factors is scored separately under the
; identification-phase and exploitation-phase point tables of the methodology.
jil-factor-scores = {
  &(elapsed-time: 0) => uint
  &(expertise: 1) => uint
  &(knowledge-of-toe: 2) => uint
  &(window-of-opportunity: 3) => uint
  &(equipment: 4) => uint
}

; Used for Scope 3 physical-attack findings established only through
; simulation (pre-silicon evidence), where JIL's attack-potential factors
; cannot be meaningfully measured. classification and assessment-type are the
; only required fields.
qualitative-rating = {
  &(classification: 0) => classification-level
  ? &(likelihood: 1) => likelihood-impact-level
  ? &(impact: 2) => likelihood-impact-level
  &(assessment-type: 4) => 2 ; qualitative-rating
}

classification-level = &(
  none: 0,
  low: 1,
  medium: 2,
  high: 3,
  critical: 4
)

likelihood-impact-level = &(
  low: 0,
  medium: 1,
  high: 2
)

fw-identifier = non-empty<{
  ? &(fw-version: 0) => version-map
  ? &(fw-file-digests: 1) => digests-type
  ? &(repo-tag: 2) => tstr
  ? &(src-manifest: 3) => src-manifest
}>

manifest-entry = {
  &(filename: 0) => tstr
  &(file-hash: 1) => digests-type 
}

src-manifest = {
  &(manifest-digest: 0) => digests-type 
  &(manifest: 1) => [ + manifest-entry ]
}